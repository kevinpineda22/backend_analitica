# Copiar a .env para desarrollo local. En Vercel van en Settings → Environment Variables.

# ── PostgreSQL: réplica de SIESA (esquema merkahorro_siesa) ─────────────────
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
# "require" activa SSL; cualquier otro valor lo apaga.
POSTGRES_SSLMODE=disable
# Milisegundos. Por debajo del timeout de la función de Vercel.
POSTGRES_STATEMENT_TIMEOUT=55000

# ── CORS ────────────────────────────────────────────────────────────────────
# Separados por coma. Acepta "*" y comodines de subdominio ("*.vercel.app").
# Vacío = localhost:5173 + merkahorro.com (con y sin www).
POWER_BI_ALLOWED_ORIGINS=

# ── Autenticación (Supabase de la app, el mismo del front) ──────────────────
# Las mismas que VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY del front.
# La anon key es pública; NO usar la service key acá.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# off | report | enforce. Vacío = report (no bloquea, registra quién llega sin
# permiso). Un valor desconocido = enforce.
ANALITICA_AUTH=report

# ── Servidor local (scripts/server.js; Vercel los ignora) ───────────────────
POWER_BI_API_PORT=3010
POWER_BI_API_HOST=127.0.0.1
